{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "skill 管理器",
  "version": "0.1.0",
  "identifier": "com.codex.skill-manager",
  "build": {
    "devUrl": "http://127.0.0.1:3211",
    "frontendDist": "../../src/static"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "skill 管理器",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 720,
        "url": "http://127.0.0.1:3211"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["../icons/app-icon.png", "icons/icon.ico"],
    "resources": ["../../src", "../../package.json"]
  }
}
